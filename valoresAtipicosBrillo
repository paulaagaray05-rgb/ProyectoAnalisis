# Importación de librerías necesarias

import os                          # Permite trabajar con archivos y carpetas
import pandas as pd                # Manejo de tablas y datos
import pydicom                     # Lectura de imágenes médicas DICOM
import numpy as np                 # Cálculos numéricos
import matplotlib.pyplot as plt    # Creación de gráficos
from tqdm import tqdm              # Barra de progreso para bucles largos


# Carpeta que contiene las imágenes DICOM del dataset RSNA
IMG_DIR = "/kaggle/input/competitions/rsna-pneumonia-detection-challenge/stage_2_train_images"


# Lista donde se almacenarán los resultados
# Cada elemento tendrá:
# [patientId, intensidad_media]
datos = []


# Recorrer todas las imágenes del dataset
for file in tqdm(os.listdir(IMG_DIR)):

    # Procesar únicamente archivos DICOM
    if file.endswith(".dcm"):

        # Obtener el identificador del paciente
        # Eliminamos la extensión ".dcm"
        patient_id = file[:-4]

        # Leer la imagen DICOM y extraer la matriz de píxeles
        img = pydicom.dcmread(
            os.path.join(IMG_DIR, file)
        ).pixel_array

        # Calcular la intensidad media de los píxeles
        # Es el promedio de todos los valores de gris de la imagen
        intensidad_media = img.mean()

        # Guardar el identificador y la intensidad media
        datos.append([patient_id, intensidad_media])


# Convertir los resultados en un DataFrame
df_int = pd.DataFrame(
    datos,
    columns=["patientId", "intensidad_media"]
)


# Mostrar estadísticas descriptivas básicas
print("\n=== Estadísticas descriptivas ===")
print(df_int["intensidad_media"].describe())


# -----------------------------
# DETECCIÓN DE VALORES ATÍPICOS
# MEDIANTE EL MÉTODO IQR
# -----------------------------

# Primer cuartil (25% de los datos)
Q1 = df_int["intensidad_media"].quantile(0.25)

# Tercer cuartil (75% de los datos)
Q3 = df_int["intensidad_media"].quantile(0.75)

# Rango intercuartílico
IQR = Q3 - Q1

# Límite inferior para detectar outliers
lim_inf = Q1 - 1.5 * IQR

# Límite superior para detectar outliers
lim_sup = Q3 + 1.5 * IQR


# Seleccionar imágenes con intensidad media fuera de los límites
outliers = df_int[
    (df_int["intensidad_media"] < lim_inf) |
    (df_int["intensidad_media"] > lim_sup)
]


# Mostrar información de los valores atípicos
print(f"\nLímite inferior IQR: {lim_inf:.2f}")
print(f"Límite superior IQR: {lim_sup:.2f}")
print(f"Número de valores atípicos: {len(outliers)}")


# -----------------------------
# HISTOGRAMA
# -----------------------------

# Crear figura
plt.figure(figsize=(10, 6))

# Dibujar distribución de intensidades medias
plt.hist(
    df_int["intensidad_media"],
    bins=50,
    edgecolor="black"
)

# Dibujar línea del límite inferior IQR
plt.axvline(
    lim_inf,
    color="red",
    linestyle="--",
    linewidth=2,
    label=f"Inferior ({lim_inf:.2f})"
)

# Dibujar línea del límite superior IQR
plt.axvline(
    lim_sup,
    color="red",
    linestyle="--",
    linewidth=2,
    label=f"Superior ({lim_sup:.2f})"
)

# Título del gráfico
plt.title("Distribución de la intensidad media de las radiografías")

# Etiqueta del eje X
plt.xlabel("Intensidad media")

# Etiqueta del eje Y
plt.ylabel("Número de imágenes")

# Mostrar leyenda
plt.legend()

# Añadir cuadrícula para facilitar la lectura
plt.grid(alpha=0.3)

# Mostrar gráfico
plt.show()